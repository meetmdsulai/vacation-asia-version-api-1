# Local development only. Copy to .env; never commit real credentials.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://vacation_asia:local_dev_only@127.0.0.1:5432/vacation_asia
POSTGRES_USER=vacation_asia
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=vacation_asia
# Optional future adapters; neither service is required by the application yet.
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://vacation_asia:local_dev_only@127.0.0.1:5672
RABBITMQ_DEFAULT_USER=vacation_asia
RABBITMQ_DEFAULT_PASS=local_dev_only
